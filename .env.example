# Copy to .env.local and fill in. Never commit .env.local.

# Site
NEXT_PUBLIC_LAUNCH_MODE=prelaunch
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase (Project Settings → Data API / General)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# Local CLI only (never needed on Vercel): database password for `supabase link` / `db push`,
# personal access token from supabase.com/dashboard/account/tokens
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# KYC (mock | qoreid)
KYC_PROVIDER=mock
QOREID_CLIENT_ID=
QOREID_SECRET=

# Payments (mock | paystack)
PAYMENTS_PROVIDER=mock
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Messaging (mock | live)
MESSAGING_PROVIDER=mock
TERMII_API_KEY=
TERMII_SENDER_ID=
RESEND_API_KEY=
EMAIL_FROM=

# AI watts lookup (mock | anthropic). The site works with mock and no key.
VISION_PROVIDER=mock
ANTHROPIC_API_KEY=
# Default: the cheapest current model with image input.
ANTHROPIC_VISION_MODEL=claude-haiku-5-5

# Guarantor links (random string, 32+ characters)
GUARANTOR_TOKEN_SECRET=

# Keyed hash of full NIN / BVN for identity matching (random string, 32+ characters).
# Set it once and never change it: existing hashes would stop matching.
ID_HASH_SECRET=

# Vercel Cron: protects /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=
# Public site URL (staff invite redirects)
NEXT_PUBLIC_SITE_URL=
